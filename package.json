{
  "name": "mysqlmern",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vite",
    "server": "node server/server.js",
    "dev": "npx concurrently \"vite\" \"npm run server\"",
    "build": "vite build",
    "preview": "vite preview",
    "restart": "npm run clean && rm -rf package-lock.json && rm -rf node_modules && npm install --legacy-peer-deps && npx npm-check-updates -u && npm install --legacy-peer-deps",
    "lint": "npx eslint . --fix",
    "format": "prettier --write .",
    "fix": "npm run format && npm run lint",
    "prettier-watch": "onchange '**/*.{ts,tsx,js,jsx,css}' -- prettier --write {{changed}}",
    "push": "npm run fix && rm -rf package-lock.json && rm -rf node_modules && git add . && git commit -m 'fix onclick, deploy backend on different server.' && git push",
    "kill": "pkill -f node",
    "clean": "npm cache clean --force && npm run build"
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:react/recommended",
      "plugin:react-hooks/recommended",
      "prettier"
    ],
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --quiet"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "dependencies": {
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@react-spring/web": "^9.7.4",
    "@vitejs/plugin-react": "^4.3.1",
    "axios": "^1.7.4",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.2",
    "bootstrap": "^5.3.3",
    "concurrently": "^8.2.2",
    "core-js": "^3.38.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "formik": "^2.4.6",
    "glob": "^11.0.0",
    "http-proxy-middleware": "^3.0.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "mysql2": "^3.11.0",
    "nodemailer": "^6.9.14",
    "nodemon": "^3.1.4",
    "pg": "^8.12.0",
    "polished": "^4.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-icons": "^5.3.0",
    "react-responsive": "^10.0.0",
    "react-router-dom": "^6.26.1",
    "rimraf": "^6.0.1",
    "sequelize": "^6.37.3",
    "styled-components": "^6.1.12",
    "vite": "^5.4.2",
    "vite-plugin-svgr": "^4.2.0",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "babel-plugin-styled-components": "^2.1.4",
    "eslint": "^9.9.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-define-config": "^2.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^28.8.0",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.9",
    "prettier": "^3.3.3",
    "react-animated-css": "^1.2.1"
  }
}
